# ============================================================
# AiDocPlus IM Bot 桥接服务 — 配置文件
# 复制为 .env 后填写相应平台的凭证
# ============================================================

# === 飞书 ===
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxxxxx
FEISHU_APP_SECRET=

# === 钉钉 ===
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=dingxxxxxx
DINGTALK_CLIENT_SECRET=

# === 企业微信 ===
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=

# === QQ ===
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=

# === AI 路由（可选，用于自然语言理解） ===
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# === 白名单（可选，逗号分隔的用户ID，留空则不限制） ===
ALLOWED_USERS=

# === 日志级别 ===
LOG_LEVEL=info
