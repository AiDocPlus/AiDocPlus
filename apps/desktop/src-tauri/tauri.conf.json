{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "AiDocPlus",
  "version": "0.3.14",
  "identifier": "com.aidocplus.app",
  "build": {
    "beforeDevCommand": "cd src-ui && pnpm dev",
    "beforeBuildCommand": "cd ../im-bot && node esbuild.config.mjs && cp dist/imbot-bundle.mjs ../desktop/src-tauri/bundled-resources/imbot-bundle.mjs && cd ../desktop/src-ui && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AiDocPlus - AI Document Editor",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: tauri: asset:; font-src 'self' data:; connect-src 'self' ipc: tauri: https: http://127.0.0.1:* http://localhost:* ws://localhost:*; media-src 'self' blob: data:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "bundled-resources/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "Developer ID Application: \u5fb7\u534e \u6c5f (3VA3JP25LX)"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMUZDMEQ3QzZCMkJBNkQKUldSdHVyTEcxOEFmRXAvc254VERYaHZUU2pySmFkRitnR1c0NkE3NEV4Zm96SWY4OERycHVCMVcK",
      "endpoints": [
        "https://gitee.com/aidocplus/aidocplus/raw/main/update/latest.json",
        "https://github.com/AiDocPlus/AiDocPlus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "cli": {
      "description": "AiDocPlus \u547d\u4ee4\u884c\u5de5\u5177",
      "args": [
        {
          "name": "version",
          "short": "v",
          "description": "\u663e\u793a\u7248\u672c\u53f7",
          "takesValue": false
        }
      ],
      "subcommands": {
        "api": {
          "description": "API \u76f8\u5173\u64cd\u4f5c",
          "subcommands": {
            "status": {
              "description": "\u67e5\u770b API Server \u72b6\u6001"
            },
            "schema": {
              "description": "\u67e5\u770b API Schema"
            },
            "call": {
              "description": "\u8c03\u7528 API \u65b9\u6cd5",
              "args": [
                {
                  "name": "method",
                  "description": "API \u65b9\u6cd5\u540d\uff08\u5982 document.list\uff09",
                  "index": 1,
                  "required": true,
                  "takesValue": true
                },
                {
                  "name": "params",
                  "short": "p",
                  "description": "JSON \u53c2\u6570",
                  "takesValue": true
                }
              ]
            }
          }
        }
      }
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "aidocplus"
        ]
      }
    }
  }
}
